# =============================================================================
# Example configuration - copy this file to .env.local (or .env) and keep only
# the lines you actually change: every variable below has a working default.
#
# NEXT_PUBLIC_* variables are inlined in the browser bundle AT BUILD TIME:
# restart `yarn dev`, or rebuild, after changing one. Never put a secret in a
# NEXT_PUBLIC_ variable - it ends up in the JavaScript served to visitors.
#
# Booleans accept true/1/yes/on and false/0/no/off. Any other value keeps the
# default, so a typo never silently hides a feature.
# =============================================================================


# -----------------------------------------------------------------------------
# Site identity
# -----------------------------------------------------------------------------

# Name displayed in the header, next to the logo.
# Default: Onward Platforms
NEXT_PUBLIC_SITE_TITLE=Onward Platforms

# Public address of the site. Used by the "Share" button (the copied link) and
# by the pre-filled Twitter/LinkedIn share URLs.
# Default: https://azureperiodictable.com/
NEXT_PUBLIC_SITE_URL=https://azureperiodictable.com/

# Path prefix when the app is not served from the root of a domain
# (e.g. /periodic-table). Used to resolve icons and static assets.
# Leave empty for a root deployment. Default: empty
NEXT_PUBLIC_BASE_PATH=


# -----------------------------------------------------------------------------
# Branding block (logo + title, on the left of the header)
# -----------------------------------------------------------------------------

# Shows the whole block. Set to false to remove the logo AND the title.
# Default: true
NEXT_PUBLIC_SHOW_BRAND=true

# Shows only the logo half of the block. Default: true
NEXT_PUBLIC_SHOW_BRAND_LOGO=true

# Shows only the title half of the block (the text of NEXT_PUBLIC_SITE_TITLE).
# Default: true
NEXT_PUBLIC_SHOW_BRAND_TITLE=true

# Image used instead of the built-in icon. The file must live in public/ and the
# path is resolved against NEXT_PUBLIC_BASE_PATH, e.g. /my-logo.svg.
# Leave empty to keep the default icon. Default: empty
NEXT_PUBLIC_BRAND_LOGO_URL=

# Makes the branding block a link opening in a new tab.
# Leave empty for a non-clickable block. Default: empty
NEXT_PUBLIC_BRAND_URL=


# -----------------------------------------------------------------------------
# Social links (header, mobile menu and share popover)
# -----------------------------------------------------------------------------

# Shows the GitHub icon. Default: true
NEXT_PUBLIC_SHOW_GITHUB=true

# Shows the LinkedIn icon, in the header and in the share popover. Default: true
NEXT_PUBLIC_SHOW_LINKEDIN=true

# Shows the Twitter icon, in the header and in the share popover. Default: true
NEXT_PUBLIC_SHOW_TWITTER=true

# Shows a link to the documentation site. Hidden by default. Default: false
NEXT_PUBLIC_SHOW_DOCS=false

# Where the GitHub icon points to.
# Default: https://github.com/onwardplatforms/azure-periodic-table-app
NEXT_PUBLIC_GITHUB_URL=https://github.com/onwardplatforms/azure-periodic-table-app

# Where the LinkedIn icon points to.
# Default: the original author's profile
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/justin-o-connor-67376483/

# Where the Twitter icon points to.
# Default: the original author's profile
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/reillyjodonnell

# Where the documentation icon points to (only shown when SHOW_DOCS is true).
# Default: https://gogo25171.github.io/azure-periodic-table-app/
NEXT_PUBLIC_DOCS_URL=https://gogo25171.github.io/azure-periodic-table-app/


# -----------------------------------------------------------------------------
# Language
# -----------------------------------------------------------------------------

# Language used on the very first render: en or fr.
# The visitor's own choice is stored in their browser and wins afterwards.
# Default: en
NEXT_PUBLIC_DEFAULT_LANGUAGE=en


# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------

# Verbosity of the shared logger (src/lib/logger.ts), in both the browser
# console and the server output: silent | error | warn | info | debug.
# Default: info in development, warn in production.
NEXT_PUBLIC_LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Admin dashboard (/admin) - SERVER SIDE, never prefix with NEXT_PUBLIC_
# -----------------------------------------------------------------------------

# Password unlocking the data health dashboard at /admin.
# While it is empty the route answers 503 and the dashboard stays disabled,
# which is the default. Use a long random value.
# Default: empty (disabled)
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Optional integrations - SERVER SIDE
# -----------------------------------------------------------------------------

# Google Analytics measurement id (e.g. G-XXXXXXXXXX). Empty disables the tag.
# Default: empty
GA_TRACKING_ID=

# OpenAI API key used by the AI chat of the resource sheet. The feature is also
# gated by ENABLE_CHAT in src/app/constants.ts, which is false by default.
# Default: empty
OPENAI_API_KEY=
