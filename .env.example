# Copy this file to .env.local and adjust the values you need.
# Every NEXT_PUBLIC_* variable is inlined at build time: rebuild after a change.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_TITLE=Onward Platforms
NEXT_PUBLIC_SITE_URL=https://azureperiodictable.com/

# Branding block of the header (logo + title on the left).
# Hide the whole block, or only one of its two halves.
NEXT_PUBLIC_SHOW_BRAND=true
NEXT_PUBLIC_SHOW_BRAND_LOGO=true
NEXT_PUBLIC_SHOW_BRAND_TITLE=true
# Replace the default icon with an image placed in public/ (leave empty to keep the icon).
NEXT_PUBLIC_BRAND_LOGO_URL=
# Make the block clickable (leave empty for no link).
NEXT_PUBLIC_BRAND_URL=
# Base path when the app is served from a sub-directory (GitHub Pages...).
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------------------
# Header and share links
# Set a NEXT_PUBLIC_SHOW_* variable to false to hide the icon everywhere.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SHOW_GITHUB=true
NEXT_PUBLIC_SHOW_LINKEDIN=true
NEXT_PUBLIC_SHOW_TWITTER=true
# The documentation link is hidden by default.
NEXT_PUBLIC_SHOW_DOCS=false

NEXT_PUBLIC_GITHUB_URL=https://github.com/onwardplatforms/azure-periodic-table-app
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/justin-o-connor-67376483/
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/reillyjodonnell
NEXT_PUBLIC_DOCS_URL=https://gogo25171.github.io/azure-periodic-table-app/

# ---------------------------------------------------------------------------
# Language and logs
# ---------------------------------------------------------------------------
# Language used on the first render: en or fr (the visitor's choice wins after that).
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
# silent | error | warn | info | debug
NEXT_PUBLIC_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Admin dashboard (/admin)
# Server side only: never prefix it with NEXT_PUBLIC_.
# Leave it empty to keep the dashboard disabled.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
GA_TRACKING_ID=
OPENAI_API_KEY=
