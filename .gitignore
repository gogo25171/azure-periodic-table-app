# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (yarn only: an npm lockfile would drift from yarn.lock)
/node_modules
package-lock.json
npm-shrinkwrap.json
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins

# testing
/coverage

# next.js
/.next/
/out/
.swc/

# production
/build

# documentation (mkdocs build output)
/site

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

# editors
.vscode/
.idea/
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# local env files
.env
.env*.local
!.env.example

# vercel
.vercel

# typescript / tooling caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo

# python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# local agent settings
.claude/settings.local.json
